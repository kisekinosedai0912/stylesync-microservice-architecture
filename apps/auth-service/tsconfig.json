{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2022"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "noImplicitReturns": true,
        "types": ["node"]
    },
    "ts-node": {
        "transpileOnly": true
    },
    "include": ["src/**/*.ts", "../../libs/shared/express.d.ts"],
    "exclude": ["node_modules", "dist"],
    "references": [
        {
            "path": "../../libs/shared/types"
        },
        {
            "path": "../../libs/shared/utils"
        }
    ]
}
