{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "../..",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
        "jsx": "react-jsx",
        "lib": ["dom", "es2022"],
        "types": ["node"],
        "paths": {
            "@stylesync/api": ["../shared/api/dist/index.d.ts"],
            "@stylesync/ui": ["../shadcn/ui/dist/index.d.ts"],
            "@stylesync/zustand": ["../zustand/index.ts"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "../zustand/**/*.ts"],
    "exclude": [
        "dist",
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "src/**/*.spec.tsx",
        "src/**/*.test.tsx"
    ]
}
