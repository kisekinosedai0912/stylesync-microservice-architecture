{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"allowImportingTsExtensions": true,
		"types": ["node"],
		"paths": {
			"@stylesync/utils": ["../../../../libs/shared/utils/index.ts"],
			"@stylesync/types": ["../../../../libs/shared/types/index.ts"]
		}
	},
  "include": [
    "src/**/*.ts",
    "index.ts"
  ],
  "references": [
    {
      "path": "../../types"
    },
    {
      "path": "../../utils"
    }
  ]
}
