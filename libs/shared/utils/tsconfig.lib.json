{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "composite": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "paths": {
      "@stylesync/types": ["../types/dist/index.d.ts"]
    }
  },
  "include": ["index.ts", "utility.ts"],
  "references": [
    {
      "path": "../types/tsconfig.lib.json"
    }
  ]
}
